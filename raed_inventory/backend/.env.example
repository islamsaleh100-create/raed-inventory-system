# ─────────────────────────────────────────────────────────────────────────────
# Raed Inventory System — Environment Variables Reference
# Copy this file to .env.local, .env.staging, or .env.production and fill in.
# Never commit real secrets to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime environment ───────────────────────────────────────────────────────
ENVIRONMENT=local                          # local | staging | production
DEBUG=true                                 # must be false for staging and production (validate_security)

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL (staging / production):
DATABASE_URL=postgresql://raed_user:raed_pass@localhost:5432/raed_inventory

# SQLite (local dev only):
# DATABASE_URL=sqlite:///./raed_inventory.db

# ── JWT / Auth ────────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480            # 8 hours

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── App meta ──────────────────────────────────────────────────────────────────
APP_NAME=Raed Inventory System
APP_VERSION=1.0.0

# ── Multi-tenancy ─────────────────────────────────────────────────────────────
# Keep MULTI_TENANT_ENABLED=False until Phase 5 tenant migration is complete.
# When False, X-Tenant-ID header is accepted but ignored; tenant_id is always 1.
MULTI_TENANT_ENABLED=False
DEFAULT_TENANT_ID=1

# ── Rate limiting (slowapi) ───────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=200/minute              # global default per IP
RATE_LIMIT_AUTH=20/minute                  # /auth/login — raise briefly if bulk role QA hits 429

# ── Permission matrix seed (staging / CI) ────────────────────────────────────
# PERMISSION_MATRIX_WORKBOOK=/secure/path/raed_user_matrix_permissions.xlsx
#   Required on staging/CI if the default path in the script does not exist.
# PERMISSION_MATRIX_PASSWORD=Raed@2025
#   Optional; must match VERIFY_API_PASSWORD when running verify_matrix_roles_api.py

# ── Sentry (optional) ─────────────────────────────────────────────────────────
# SENTRY_DSN=https://...@.ingest.sentry.io/...
#   Requires: pip install sentry-sdk[fastapi]

# ── Matrix API smoke script (scripts/verify_matrix_roles_api.py) ─────────────
# VERIFY_API_BASE=http://127.0.0.1:8010
# VERIFY_API_PASSWORD=Raed@2025
# VERIFY_LOGIN_DELAY_S=3.2

# ── Staging DB bring-up (ordered; cwd = raed_inventory/backend) ───────────────
# 0. ENV_FILE=.env.staging  (or export vars) — PostgreSQL DATABASE_URL, strong
#    SECRET_KEY, DEBUG=false, ALLOWED_ORIGINS, ADMIN_PASSWORD ≠ default
# 1. alembic upgrade head
# 2. If brands/sections/demo baseline are missing: python seed_supply_chain_demo.py
#    (idempotent; supplies Brand rows required by seed_official_branches.py)
# 3. python seed_official_branches.py
# 4. If this DB ever used supply-chain demo branches: python finalize_demo_branch_transition.py
# 5. PERMISSION_MATRIX_WORKBOOK=... python seed_users_from_permission_matrix.py
# 6. python backfill_kitchen_assignment_service_city.py
# 7. python backfill_official_kitchens.py
# 8. Smoke: ENV_FILE=.env.staging  python scripts/verify_matrix_roles_api.py
#    (checks GET /api/v1/ready first — expect 200)
# Optional: POST /api/v1/master/kitchens (admin) or UI /admin/kitchens

# ── Idempotency ───────────────────────────────────────────────────────────────
IDEMPOTENCY_CLEANUP_INTERVAL_SECONDS=3600  # purge keys older than TTL each hour
IDEMPOTENCY_TTL_SECONDS=86400              # 24 hours

# ── Audit log ────────────────────────────────────────────────────────────────
AUDIT_LOG_ENABLED=true                     # set false to disable audit writes

# ── First Admin (seed only — not used after first run) ────────────────────────
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@raed.com
ADMIN_PASSWORD=Admin@2025

# ── ENV_FILE override ────────────────────────────────────────────────────────
# Point uvicorn startup to a specific env file:
#   ENV_FILE=.env.local   uvicorn app.main:app ...
# ENV_FILE=.env.local
